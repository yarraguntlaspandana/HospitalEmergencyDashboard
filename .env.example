# ─────────────────────────────────────────────────────────────────────────────
# Hospital Emergency Network Dashboard — Environment Variables
#
# Copy this file to .env and fill in your own values.
# The .env file is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Port the HTTP server listens on (default: 8080)
SERVER_PORT=8080

# Host / bind address (default: localhost)
SERVER_HOST=localhost

# Log level: INFO | DEBUG | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# ─── Optional: future database / external API settings ───────────────────────
# Uncomment and fill when connecting a real backend

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hospital_emergency
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# EXTERNAL_API_KEY=your_api_key_here
# EXTERNAL_API_BASE_URL=https://api.example.com
